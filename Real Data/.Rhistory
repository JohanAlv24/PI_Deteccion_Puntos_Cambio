#| label: cambio-promedio
#| echo: false
escenario_5 <- base_modelo
escenario_8 <- base_modelo
escenario_5$satisfaccion_areas_verdes <- 5
escenario_8$satisfaccion_areas_verdes <- 8
prob_5 <- predict(modelo_ajustado, newdata = escenario_5, type = "probs")
prob_8 <- predict(modelo_ajustado, newdata = escenario_8, type = "probs")
cambio_promedio <- 100 * colMeans(prob_8 - prob_5)
print(round(cambio_promedio, 2))
stopifnot(abs(sum(cambio_promedio)) < 1e-8)
#| label: cambio-promedio-ampliado
#| echo: false
prob_5_ampliado <- predict(
modelo_ampliado, newdata = escenario_5, type = "probs"
)
prob_8_ampliado <- predict(
modelo_ampliado, newdata = escenario_8, type = "probs"
)
# Cada fila debe contener probabilidades válidas que sumen uno
stopifnot(
all(is.finite(prob_5_ampliado)),
all(is.finite(prob_8_ampliado)),
all(prob_5_ampliado >= 0 & prob_5_ampliado <= 1),
all(prob_8_ampliado >= 0 & prob_8_ampliado <= 1),
all(abs(rowSums(prob_5_ampliado) - 1) < 1e-8),
all(abs(rowSums(prob_8_ampliado) - 1) < 1e-8)
)
cambio_promedio_ampliado <- 100 * colMeans(
prob_8_ampliado - prob_5_ampliado
)
tabla_cambios <- data.frame(
categoria = names(cambio_promedio),
ajustado_pp = unname(cambio_promedio),
ampliado_pp = unname(
cambio_promedio_ampliado[names(cambio_promedio)]
)
)
tabla_cambios$diferencia_pp <- (
tabla_cambios$ampliado_pp - tabla_cambios$ajustado_pp
)
knitr::kable(
tabla_cambios,
digits = 2,
caption = "Cambio promedio de probabilidades: áreas verdes de 5 a 8"
)

#| label: bootstrap-cambio
#| echo: false
#| warning: true
set.seed(123)
B <- 500
modelos_boot <- list(
Ajustado = modelo_ajustado,
Ampliado = modelo_ampliado
)
# Reestima el modelo y calcula el contraste sobre los perfiles originales.
calcular_cambio_boot <- function(modelo, muestra) {
tryCatch({
ajuste <- suppressWarnings(
update(modelo, data = muestra, Hess = FALSE)
)
if (ajuste$convergence != 0) {
return(NA_real_)
}
p5 <- predict(ajuste, newdata = escenario_5, type = "probs")
p8 <- predict(ajuste, newdata = escenario_8, type = "probs")
100 * mean(p8[, "Máxima"] - p5[, "Máxima"])
}, error = function(e) NA_real_)
}
cambios_boot <- replicate(B, {
muestra_boot <- base_modelo[
sample.int(nrow(base_modelo), replace = TRUE),
]
vapply(
modelos_boot,
calcular_cambio_boot,
numeric(1),
muestra = muestra_boot
)
})
tabla_boot <- data.frame(
modelo = names(modelos_boot),
replicas_validas = NA_integer_,
inferior_pp = NA_real_,
mediana_pp = NA_real_,
superior_pp = NA_real_
)
for (i in seq_along(modelos_boot)) {
cambios <- cambios_boot[i, ]
cambios <- cambios[is.finite(cambios)]
tabla_boot$replicas_validas[i] <- length(cambios)
if (length(cambios) >= 0.9 * B) {
tabla_boot[i, c("inferior_pp", "mediana_pp", "superior_pp")] <-
as.list(unname(quantile(cambios, c(0.025, 0.5, 0.975))))
} else {
warning(
"Demasiadas réplicas fallidas en el modelo ",
names(modelos_boot)[i]
)
}
}
knitr::kable(
tabla_boot,
digits = 2,
row.names = FALSE,
caption = paste(
"Bootstrap de hogares: contraste promedio de 5 a 8",
"para satisfacción Máxima"
)
)

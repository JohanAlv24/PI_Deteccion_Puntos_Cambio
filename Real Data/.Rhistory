function(z) all(diff(z) > 0)
)
cat(
"Simulaciones con umbrales ordenados:",
sum(validas), "de", nsim, "\n"
)
if (sum(validas) < 0.95 * nsim) {
warning("Se descartó más del 5 % de las simulaciones; revisar las bandas")
}
stopifnot(sum(validas) >= 2)
theta_sim <- theta_sim[validas, , drop = FALSE]
calcular_probs <- function(eta, zeta) {
acumuladas <- sapply(
zeta,
function(a) plogis(a - eta)
)
if (is.vector(acumuladas)) {
acumuladas <- matrix(
acumuladas,
nrow = length(eta)
)
}
J <- length(zeta) + 1
probs <- matrix(
NA,
nrow = length(eta),
ncol = J
)
probs[, 1] <- acumuladas[, 1]
if (J > 2) {
for (j in 2:(J - 1)) {
probs[, j] <-
acumuladas[, j] -
acumuladas[, j - 1]
}
}
probs[, J] <- 1 - acumuladas[, J - 1]
probs
}
categorias <- levels(
model.response(datos_modelo)
)
grid <- seq(
desde,
hasta,
by = paso
)
alpha <- 1 - nivel
resultados <- list()
for (g in seq_along(grid)) {
x_actual <- grid[g]
nuevos_datos <- datos_x
nuevos_datos[[variable]] <- x_actual
X <- model.matrix(
delete.response(terms(modelo)),
data = nuevos_datos
)
X <- X[, names(beta_hat), drop = FALSE]
eta_hat <- drop(
X %*% beta_hat
)
probs_hat <- calcular_probs(
eta_hat,
zeta_hat
)
stopifnot(
isTRUE(all.equal(
unname(probs_hat),
unname(predict(modelo, newdata = nuevos_datos, type = "probs")),
tolerance = 1e-8
))
)
prob_promedio <- colMeans(
probs_hat
)
probs_sim <- matrix(
NA,
nrow = nrow(theta_sim),
ncol = length(categorias)
)
for (b in seq_len(nrow(theta_sim))) {
beta_b <- theta_sim[
b,
names(beta_hat)
]
zeta_b <- theta_sim[
b,
names(zeta_hat)
]
eta_b <- drop(
X %*% beta_b
)
p_b <- calcular_probs(
eta_b,
zeta_b
)
probs_sim[b, ] <- colMeans(
p_b
)
}
inferior <- apply(
probs_sim,
2,
quantile,
probs = alpha / 2,
na.rm = TRUE
)
superior <- apply(
probs_sim,
2,
quantile,
probs = 1 - alpha / 2,
na.rm = TRUE
)
resultados[[g]] <- data.frame(
valor = x_actual,
categoria = categorias,
probabilidad = prob_promedio,
inferior = inferior,
superior = superior
)
}
resultados <- dplyr::bind_rows(
resultados
)
grafico <- ggplot2::ggplot(
resultados,
ggplot2::aes(
x = valor,
y = probabilidad,
linetype = categoria,
group = categoria
)
) +
ggplot2::geom_ribbon(
ggplot2::aes(
ymin = inferior,
ymax = superior,
fill = categoria
),
alpha = 0.15,
colour = NA
) +
ggplot2::geom_line(
ggplot2::aes(
color = categoria
),
linewidth = 1
) +
ggplot2::labs(
x = "Satisfacción con áreas verdes",
y = "Probabilidad predicha promedio",
color = "Satisfacción con el entorno",
fill = "Satisfacción con el entorno",
linetype = "Satisfacción con el entorno",
title = "Probabilidades predichas según satisfacción con áreas verdes",
subtitle = paste0(
"Bandas de confianza del ",
nivel * 100,
"%"
),
caption = caption
) +
ggplot2::scale_y_continuous(
limits = c(0, 1),
labels = scales::percent
) +
ggplot2::theme_minimal() +
ggplot2::theme(
plot.caption = ggplot2::element_text(
hjust = 0,
face = "italic"
)
)
return(
list(
datos = resultados,
grafico = grafico
)
)
}
